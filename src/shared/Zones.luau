--!strict
-- The four zones of Vesperdeep, drawn as ASCII tile maps (1 character = 1 tile).
--
-- Legend
--   #  rough stone (solid, clingable)      %  smooth stone (solid, cannot be clung to)
--   ^  thorns / spikes (hazard)            X  cracked wall (breakable secret)
--   S  first spawn                          B  bench (checkpoint)
--   G  boss gate (closes during a fight)   T  boss trigger line
--   1-9 doorway: leads to the doorway with the same digit in another zone
--   c  husk mite (crawler)   f  gloom gnat (flyer)   s  spore bulb (spitter)   g  shellguard (charger)
--   Any other letter is looked up in the zone's `specials` table.

export type Special = { kind: string, id: string?, amount: number?, tablet: boolean?, arena: { number }? }
export type Zone = {
	id: string,
	name: string,
	subtitle: string,
	theme: string,
	music: string,
	specials: { [string]: Special },
	map: { string },
}

