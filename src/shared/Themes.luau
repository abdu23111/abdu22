--!strict
-- Colour palettes, materials and lighting moods for each region. Each region owns its own pair
-- of terrain materials (Roblox tints terrain per material, so no two regions share one) and a
-- small set of glow colours for its light pools. Colours are rich but coordinated: a base
-- stone, a warmer or cooler floor, one or two glow accents, and trims that separate floor,
-- wall and background.

export type Theme = {
	rock: Color3, -- main stone (part-built rocks, boulders)
	rockDark: Color3, -- deep stone: cracks, shadowed recesses
	rim: Color3, -- light trim: ledge tops, carved edges
	smooth: Color3, -- smooth (unclimbable) stone and dressed masonry
	backWall: Color3,
	far: { Color3 }, -- distant scenery, near to far
	accent: Color3, -- the region's signature glow
	glow: { Color3 }, -- colours for light pools
	flora: Color3, -- moss, leaves, vines
	bone: Color3, -- fossils
	wood: Color3,
	fabric: Color3, -- banners, awnings
	fog: Color3,
	fogStart: number,
	fogEnd: number,
	ambient: Color3,
	outdoor: Color3,
	tint: Color3, -- colour correction tint
	material: Enum.Material, -- part material matching the terrain walls
	decor: string, -- which set dressing CaveArt uses
	-- Terrain: rock for walls and ceilings, a surface material for walkable tops.
	wall: Enum.Material,
	top: Enum.Material,
	wallColor: Color3,
	topColor: Color3,
}

